{
  "manifest_version": 3,
  "name": "Scrollopsy",
  "version": "0.2.0",
  "description": "Observes your YouTube Shorts scrolling session and creates an entertaining autopsy of your attention.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scrollopsy",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "contentExtractor.js",
        "semanticEngine.js",
        "behaviorAnalysis.js",
        "patternDetector.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["report.html", "report.css", "report.js", "contentTrail.js", "behaviorAnalysis.js", "patternDetector.js", "semanticEngine.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
